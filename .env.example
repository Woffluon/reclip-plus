# ==============================================================================
# ReClip Plus — Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8899
HOST=0.0.0.0

# Concurrency & Performance
MAX_CONCURRENT_DOWNLOADS=2
YTDLP_CONCURRENT_FRAGMENTS=4

# Storage & Quotas
RECLIP_DOWNLOAD_DIR=downloads
MIN_FREE_DISK_SPACE_MB=500
DOWNLOAD_TTL=3600
DELETE_AFTER_DOWNLOAD=false

# Resource Limits
MAX_PLAYLIST_ITEMS=50
MAX_DURATION=0
MAX_ESTIMATED_FILE_SIZE=0

# Metadata Cache
METADATA_CACHE_TTL=600
METADATA_CACHE_MAX_SIZE=500

# Security
ENABLE_SSRF_PROTECTION=true

# Container Startup Updates (0 = disabled for instant boot, 1 = check and update)
RECLIP_UPDATE_ON_STARTUP=0
